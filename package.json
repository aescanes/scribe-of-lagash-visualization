{
	"name": "scribe-of-lagash-visualization",
	"version": "0.1.1",
	"description": "Visualize your novel's chapters and scenes: build timelines and group them into matrices by character, place, or situation.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node esbuild.test.mjs && node --test .test-build",
		"version-patch": "npm version patch --ignore-scripts=false",
		"version-minor": "npm version minor --ignore-scripts=false",
		"version-major": "npm version major --ignore-scripts=false",
		"rebuild:esbuild": "npm rebuild esbuild --ignore-scripts=false"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"novel-writing",
		"writing",
		"timeline"
	],
	"author": "aescanes",
	"license": "GPL-3.0-or-later",
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@types/node": "20.19.43",
		"@typescript-eslint/eslint-plugin": "8.68.0",
		"@typescript-eslint/parser": "8.68.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.28.2",
		"eslint": "9.39.5",
		"obsidian": "1.13.1",
		"tslib": "2.6.2",
		"typescript": "5.3.3"
	}
}
