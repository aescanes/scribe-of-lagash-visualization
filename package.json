{
	"name": "scribe-of-lagash-visualization",
	"version": "0.9.4",
	"description": "Visualize your story's chapters and scenes: arrange them on lines and group them into matrices by character, place, or situation.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node esbuild.test.mjs && node --test \".test-build/**/*.test.js\"",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint": "eslint .",
		"lint:css": "stylelint styles.css",
		"validate": "npm run typecheck && npm test && npm run lint && npm run lint:css",
		"version": "node version-changelog.mjs && node version-bump.mjs && git add CHANGELOG.md manifest.json versions.json",
		"postversion": "node version-tag.mjs",
		"version-patch": "npm version patch --ignore-scripts=false",
		"version-minor": "npm version minor --ignore-scripts=false",
		"version-major": "npm version major --ignore-scripts=false",
		"rebuild:esbuild": "npm rebuild esbuild --ignore-scripts=false",
		"prepare": "husky"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"story-writing",
		"writing"
	],
	"author": "aescanes",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "24.13.3",
		"esbuild": "0.28.2",
		"eslint": "10.9.1",
		"eslint-plugin-obsidianmd": "0.4.2",
		"husky": "9.1.7",
		"obsidian": "1.13.1",
		"stylelint": "17.15.0",
		"stylelint-config-obsidianmd": "0.1.0",
		"tslib": "2.8.1",
		"typescript": "5.3.3"
	}
}
