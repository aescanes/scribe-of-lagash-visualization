# Never silently run a dependency's install/postinstall script. This blocks
# arbitrary code execution from a compromised or malicious package during
# `npm install`/`npm ci`. The one legitimate exception in this project is
# esbuild, which needs its postinstall to link the correct platform binary;
# that is run explicitly and visibly via `npm run rebuild:esbuild` (see README).
ignore-scripts=true

# Always write exact resolved versions to package.json (no ^ or ~ ranges),
# so a later `npm install <pkg>` can't silently widen what future installs
# are allowed to pull in.
save-exact=true

# `npm version` should tag as "1.2.3", not "v1.2.3": the Release workflow
# triggers on "*.*.*" tags and checks the tag name against manifest.json's
# version, which has no leading "v". See "Releasing" in CONTRIBUTING.md.
tag-version-prefix=""
